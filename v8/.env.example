# SuiteCRM API V8 Configuration
# Copy this file to .env and fill in your values

# Root URL of the SinergiaCRM instance (MUST include the instance path, e.g. /sinergiacrm).
# Local Docker dev: use the docker service name — the demo's server-side curl runs
# inside the php-fpm container where localhost:8000 is NOT reachable:
#   SUITECRM_BASE_URL=http://sw-webserver/sinergiacrm
SUITECRM_BASE_URL=http://localhost:8000/sinergiacrm
OAUTH2_CLIENT_ID=your-client-id-here
OAUTH2_CLIENT_SECRET=your-client-secret-here
