# SinergiaCRM API v4.1 — Demo Client Configuration
# Copy this file to .env and set your values:
#   cp .env.example .env

# SinergiaCRM URL (browser-accessible)
CRM_URL=http://localhost:8000/sinergiacrm

# CRM REST endpoint path (relative to CRM_URL)
API_PATH=/custom/service/v4_1_SticCustom/rest.php

# CRM user for REST authentication
CRM_USER=your-crm-user

# CRM user password
CRM_PASSWORD=your-password

# Language for API interactions (es_ES, ca_ES, gl_ES, en_us)
API_LANGUAGE=es_ES
