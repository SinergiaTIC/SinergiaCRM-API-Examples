# SinergiaCRM Portal OAuth — Demo Client Configuration
# Copy this file to .env and set your values:
#   cp .env.example .env

# Public CRM URL (browser-accessible)
CRM_URL=http://localhost:8000/sinergiacrm

# Internal URL for curl calls from PHP.
# Use Docker service name if behind a reverse proxy (e.g. http://sw-webserver/sinergiacrm).
# If remote or same as CRM_URL, leave empty to default to CRM_URL.
CRM_INTERNAL=

# OAuth2 Client UUID — create in CRM: Administration → OAuth2 Clients → New Portal Client
OAUTH_CLIENT_ID=your-oauth2-client-uuid

# Client secret — only required for confidential portal clients (those that were
# created with a stored secret). Leave empty for secret-less portal clients.
OAUTH_CLIENT_SECRET=

# Must match the redirect_uri on the OAuth2 Client exactly
OAUTH_REDIRECT_URI=http://localhost:8000/SinergiaCRM-API-Examples/PortalOauth/callback.php
